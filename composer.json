{
    "name": "forest-lynx/moonshine-input-extension-calculator",
    "description": "",
    "keywords": [
        "moonshine",
        "input extension",
        "calculator"
    ],
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/forest-lynx/moonshine-input-extension-calculator/issues",
        "source": "https://github.com/forest-lynx/moonshine-input-extension-calculator"
    },
    "authors": [
        {
            "name": "Дмитрий М",
            "email": "trot505@yandex.ru",
            "role": "Developer"
        }
    ],
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.0",
        "phpstan/phpstan": "^2.0"
    },
    "require": {
        "php": "^8.1",
        "ext-intl": "*",
        "moonshine/moonshine": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "ForestLynx\\MoonShine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ForestLynx\\MoonShine\\Tests\\": "tests/"
        }
    },
    "conflict": {
        "moonshine/moonshine": "<4.0"
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "analyze": "./vendor/bin/phpstan analyze src --level=9",
        "rector": "./vendor/bin/rector process src --dry-run",
        "rector:fix": "./vendor/bin/rector process src"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ForestLynx\\MoonShine\\Providers\\CalculatorServiceProvider"
            ]
        }
    }
}
